{
  "name": "shortglish",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "yarn workspace @shortglish/client dev",
    "dev:client": "yarn workspace @shortglish/client dev",
    "dev:server": "yarn workspace @shortglish/server dev",
    "build": "yarn workspace @shortglish/client build && yarn workspace @shortglish/server build",
    "build:client": "yarn workspace @shortglish/client build",
    "build:server": "yarn workspace @shortglish/server build",
    "lint": "yarn workspace @shortglish/client lint && yarn workspace @shortglish/server lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.6.1",
    "typescript": "~5.8.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
